---
import TopBar from "../components/TopBar.astro";
import Layout from "../layouts/Layout.astro";
import Project from "../components/Project.astro";

const projects = Object.values(import.meta.glob('./projects/*.mdx', { eager: true }));



// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<script src="../ts/project-hover-colour.ts" />
	<div id="content">
		<div id="intro">
			<div class="left">
				<h1>This is my intro heading</h1>
				<p>This is my intro paragraph. This is my intro paragraph. This is my intro paragraph. This is my intro paragraph.</p>
				<a onclick='document.getElementById("projects").scrollIntoView({behavior: "smooth"})' class="button">View Projects</a>
			</div>
			<div class="aboutme">
				<h1>About Me</h1>
				<p>Click here to see a timeline of my games design career from age 7 all the way to age 18</p>
				<a href="AboutMe" class="button">About Me</a>
			</div>
			
		</div>
		<div id="project-holder">
			<div id="projects">
				<div id="unity">
					<h1>Unity</h1>
					<div class="cards">
						{projects.map((project: any) => project.frontmatter.software == "unity" ? <Project title={project.frontmatter.title}, image={project.frontmatter.image}, url={project.url}, description={project.frontmatter.description}/> : "")}
					</div>
				</div>
				<div id="unreal">
					<h1>Unreal</h1>
					<div class="cards">
						{projects.map((project: any) => project.frontmatter.software == "unreal" ? <Project title={project.frontmatter.title}, image={project.frontmatter.image}, url={project.url}, description={project.frontmatter.description}/> : "")}
					</div>
				</div>
				<h1>Blender</h1>
				<div id="blender">
					<div class="cards">
						{projects.map((project: any) => project.frontmatter.software == "blender" ? <Project title={project.frontmatter.title}, image={project.frontmatter.image}, url={project.url}, description={project.frontmatter.description}/> : "")}
					</div>
				</div>
			</div>
		</div>
		
	</div>
</Layout>

<style lang="scss">
	@use "../scss/consts";
	#content {
		display: flex;
		align-items: center;
		flex-direction: column;

		#intro{
			width: 80%;
			margin-top: 8em;
			display: flex;
			justify-content: space-around;

			a{
				font-size: 1.3em;
				&:hover{
					cursor: pointer;
				}
			}

			.left,.aboutme{
				width: 24em;
			}

			&>div{
				display: flex;
				flex-direction: column;
				justify-content: space-around;				
			}
		}

		#project-holder{
			display: flex;
			justify-content: center;
			align-items: center;
			width: 80%;

			#projects{
				margin-top: 40em;
				margin-bottom: 100em;
				width: 100vw;
				display: flex;
				flex-direction: column;

				#unity,#unreal,#blender{
					transition: all .3s ease;
					margin-bottom: 5em;
					padding: 1.5em;
					border-radius: .5em;
					display: flex;
					flex-direction: column;
					justify-content: space-between;
					align-items: baseline;
					
					
					

					h1{

						font-size: 2.5em;

						margin: {
							top: 0em;
							right: 0em;
							left: 0em;
							bottom: .25em;
						};
						
						padding: {
							top: .5em;
							bottom: .5em;
						};

					}
				}

				#unity{
					background-color: consts.$Backdrop1;					
				}

				.cards{
					display: flex;
					align-items: center;

					

				}

				

				&>a{
					margin-left: 1em;
					margin-right: 1em;
				}
			}
		}
		
	}
</style>
