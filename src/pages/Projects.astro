---
import Project from "../components/Project.astro";
import Video from "../components/Video.astro";
import Main from "../layouts/Main.astro";

const projects = Object.values(import.meta.glob('./projects/*.mdx', { eager: true }));

---

<Main title="Projects">
    <script src="../js/ScrollLock.ts" />
    <script src="../js/ExtraCardAdder.ts" />

    <div id="top">

    </div>
    <div id="content">
        <div id="video">
            <Video width="875" height="492" urk="IXzj58fsSNc"/>
        </div>
        <div id="projects">
            
            {projects.map((project: any) => project.frontmatter.focus ? <Project title={project.frontmatter.title}, image={project.frontmatter.image}, url={project.url}, description={project.frontmatter.description}, software={project.frontmatter.software.split(" ").join(" • ")}/> : "")}
            {projects.map((project: any) => project.frontmatter.software.includes("Unity") && !project.frontmatter.focus ? <Project title={project.frontmatter.title}, image={project.frontmatter.image}, url={project.url}, description={project.frontmatter.description}, software={project.frontmatter.software.split(" ").join(" • ")}/> : "")}
            {projects.map((project: any) => project.frontmatter.software.includes("Unreal") && !project.frontmatter.focus ? <Project title={project.frontmatter.title}, image={project.frontmatter.image}, url={project.url}, description={project.frontmatter.description}, software={project.frontmatter.software.split(" ").join(" • ")}/> : "")}
            {projects.map((project: any) => project.frontmatter.software == "more" && !project.frontmatter.focus ? <Project title={project.frontmatter.title}, image={project.frontmatter.image}, url={"#/"}, description={project.frontmatter.description}/> : "")}
        </div>
        
    </div>
</Main>

<style lang="scss">
    @use "../style/consts";
    #content{

        @media (orientation: portrait), (max-width: consts.$VerticalModePX){
            #video{
                display: none;
            }
            #projects{
                align-items: center;
                flex-direction: column;
            }
            
        }

        
        
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-around;
        margin-top: 15vh;

        #projects{
            
            justify-content: space-between;
            margin-top: 3em;
            display: flex; 
            flex-wrap: wrap;
            width: 55em;
            
           
        }


        // div{
        //     margin-top: 5em;
        //     h1{
        //         color: #C5B28B;
        //         margin-bottom: 3em;
        //     }
        //     display: flex;
        //     flex-direction: column;
        //     align-items: center;
        // }
    }
</style>