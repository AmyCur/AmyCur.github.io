---
import Project from "../components/Project.astro";
import Layout from "../layouts/Layout.astro";

const projects = Object.values(import.meta.glob('./projects/*.md', { eager: true }));

---

<Layout title="Projects">
    <div id="top">

    </div>
    <div id="projects">
        {projects.map((project: any) => /*project.frontmatter.software == "unity" ? */ <Project title={project.frontmatter.title}, image={project.frontmatter.image}, url={project.url}, description={project.frontmatter.description}/> /*: ""*/)}
    </div>
</Layout>