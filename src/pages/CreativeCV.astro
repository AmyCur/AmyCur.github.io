---
import Software from "../components/Software.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Creative CV</title>
    </head>
    <body>
        <div id="contents">
            <div id="programs">
                <Software title="Contacts.exe" icon="JumpShot.png" />
                <Software title="Personal Summary.exe" icon="JumpShot.png" />
                <Software title="Work history.exe" icon="JumpShot.png" />
                <Software title="Education.exe" icon="JumpShot.png" />
            </div>
        </div>
        <div id="window">
            a
        </div>
    </body>
</html>

<style lang="scss">

    :root{

    }

    body,html{
        margin: 0px;
    }
    #contents {
        width: 100vw;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;

        #programs {
            width: 70vw;
            height: 50vh;

            display: flex;
            justify-content: space-around;
            align-items: center;

            background-color: crimson;
        }
    }

    $window-width: 80vw;
    $window-height: 70vh;

    #window{
        position: absolute;
        left: 50vw - ($window-width/2);
        top: 50vh - ($window-height/2);
        width: $window-width;
        height: $window-height;
        background-color: black;
        opacity: 0;
        transition: all .3s ease;
        z-index: -1;
    }
</style>

<script lang="js">
    addEventListener("DOMContentLoaded", () => {
        let window = {
            active: false,
            element: document.getElementById("window")
        }

        const softwares = document.getElementsByClassName("software");

        document.addEventListener("click", (event) => {
            // I hate this language i want to fucking hang myself so bad
            console.log(`${event.target.id} != ${window.element.id}`);
            console.log(window.active);
            if(window.active && event.target!=window.element){
                console.log(`${event.target} != ${window.element}`);
                if(window.active){
                    console.log(event.target);
                    window.element.style.opacity=0;
                    window.element.style.zIndex=-1;
                }     
            }
        })
        
        for (const software of softwares) {
            software.addEventListener("click", () => {
                window.element.style.opacity=1;
                window.element.style.zIndex=1;
                window.active = !window.active;
            });            
        }        
    });
</script>
