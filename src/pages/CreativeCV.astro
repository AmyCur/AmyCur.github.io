        <div id="contents">
            <div id="programs">
                <Software title="Contacts.exe" icon="JumpShot.png" />
                <Software title="Personal Summary.exe" icon="JumpShot.png" />
                <Software title="Work history.exe" icon="JumpShot.png" />
                <Software title="Education.exe" icon="JumpShot.png" />
            </div>
        </div>
        <div id="window">
            <div id="top-bar">
                <div id="left">Name</div>
                <div id="right">close button</div>
