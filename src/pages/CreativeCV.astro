<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creative CV</title>
</head>
<body>
    <div id="box">
        <div id="topbar">
            <span id="min">X</span>
            <span>0</span>
            <span>L</span>
        </div>
        <div id="content">
            Here is my content
        </div>
    </div>
</body>
</html>

<style lang="scss">
    body{
        margin: 0px;
    }
    #box{

        margin-top: 5vh;
        left: 30em;
        top: 10em;

        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;


        #topbar{

            
            span{
                display: flex;
                height: 1vh;
            }
            
            display: flex;
            justify-content: space-around;
            align-content: center;


            background-color: blueviolet;
            border: 1px solid blueviolet;
            height: 30px;
            width: 60em;

            
        }

        #content{
            transition: all .3s ease;
            display: flex;
            justify-content: center;
            height: 80vh;
            width: 60em;

            border: {
                left: 1px solid black;
                right: 1px solid black;
                bottom: 1px solid black;
            };
        }
    }
</style>

<script lang="js">

    let minimised = false;

    addEventListener("DOMContentLoaded", () => {
        document.getElementById("min").addEventListener("click", () => {
            document.getElementById("content").style.height= minimised ? "80vh" : "0vh";
            document.getElementById("content").style.color= minimised ? "#000" : "#00000000";
            minimised=!minimised;
        });
        
    });
</script>