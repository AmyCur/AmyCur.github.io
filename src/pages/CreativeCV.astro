import Software from "../components/Software.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Creative CV</title>
    </head>
    <body>
        <div id="contents">
            <div id="programs">
                <Software title="Contacts.exe" icon="JumpShot.png" />
                <Software title="Personal Summary.exe" icon="JumpShot.png" />
                <Software title="Work history.exe" icon="JumpShot.png" />
                <Software title="Education.exe" icon="JumpShot.png" />
            </div>
        </div>
        <div id="window">
            <div id="top-bar">
                <div id="left">Name</div>
                <div id="right">close button</div>
            </div>
            <div id="content">Default window text (this system is stupid)</div>
        </div>
        <div id="Contacts">
            This is my contacts content
        </div>
        <div id="Personal">
            This is my personal content
        </div>
        <div id="Work">
            This is my work content
        </div>
        <div id="Education">
            This is my education content
        </div>
    </body>
</html>

<style lang="scss">

    :root{
        color-scheme: light dark;
        font-family: sans-serif;
    }

    #Contacts,#Personal,#Work,#Education{
        display: none;
        position: absolute;
    }

    body,html{
        margin: 0px;
    }
    #contents {
        width: 100vw;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;

        #programs {
            width: 70vw;
            height: 50vh;

            display: flex;
            justify-content: space-around;
            align-items: center;

            background-color: crimson;
        }
    }

    $window-width: 80vw;
    $window-height: 70vh;

    #window{
        position: absolute;
        left: 50vw - ($window-width/2);
        top: 50vh - ($window-height/2);
        width: $window-width;
        height: $window-height;
        background-color: light-dark(#fff, #2D3034);
        color: light-dark(black, white);
        // opacity: 0;
        transition: opacity .3s ease;
        // z-index: -1;
        display: flex;
        flex-direction: column;

        #top-bar{
            display: flex;
            justify-content: space-between;
            background-color: #18191B;
        }

        #content{
            margin-left: 1em;
        }
    }
</style>

<script lang="js">
    let page = {
        active: false,
        element: document.getElementById("window"),
        content: document.getElementById("content"),
        name: document.getElementById("left"),

        UpdatePageStyle: function(){
            this.element.style.zIndex = this.active ? 1 : -1;
            this.element.style.opacity = this.active ? 1 : 0;
        }
    }

    const softwares = document.getElementsByClassName("software");
    let justActive=false;

    for(const soft of softwares){
        soft.addEventListener("click", () => {
            page.active=true;
            page.UpdatePageStyle();
        });
    }

    const containers = ["Contacts", "Personal", "Work", "Education"]

    function PopulateBox(event){
        // Im such a failure
        const parent = event.target.getAttribute('class') != null ? event.target : event.target.parentNode;
        
        if(parent!=null){
            const link = parent.dataset;
            if(link.title!=null){
                for(const c of containers){
                    if(link.title.includes(c)){
                        page.content.innerHTML = document.getElementById(c).innerHTML;
                        page.name.innerHTML = link.title.split(".")[0];
                    }
                }
                
            }
            
        }
       

    }

    document.addEventListener("click", (event) => {
        let ware = false;

        // I should be more embarrased, this is humiliating
        if(event.target.getAttribute('class') || event.target.parentNode.getAttribute('class')==="software"){ 
            ware=true;
        }

        PopulateBox(event);

        if(event.target!==page.element && !ware){
            page.active=false;
            page.UpdatePageStyle();
        }
    })
</script>
