---
import Software from "../components/Software.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Creative CV</title>
    </head>
    <body>
        <div id="contents">
            <div id="programs">
                <Software title="Contacts.exe" icon="JumpShot.png" />
                <Software title="Personal Summary.exe" icon="JumpShot.png" />
                <Software title="Work history.exe" icon="JumpShot.png" />
                <Software title="Education.exe" icon="JumpShot.png" />
            </div>
        </div>
        <div id="window">
            a
        </div>
    </body>
</html>

<style lang="scss">

    :root{

    }

    body,html{
        margin: 0px;
    }
    #contents {
        width: 100vw;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;

        #programs {
            width: 70vw;
            height: 50vh;

            display: flex;
            justify-content: space-around;
            align-items: center;

            background-color: crimson;
        }
    }

    $window-width: 80vw;
    $window-height: 70vh;

    #window{
        position: absolute;
        left: 50vw - ($window-width/2);
        top: 50vh - ($window-height/2);
        width: $window-width;
        height: $window-height;
        background-color: black;
        opacity: 0;
        transition: all .3s ease;
        z-index: -1;
    }
</style>

<script lang="js">
    let page = {
        active: false,
        element: document.getElementById("window"),

        UpdatePageStyle: function(active){
            this.element.style.zIndex = active ? 1 : -1;
            this.element.style.opacity = active ? 1 : 0;
            console.log(this);
        }
    }

    const softwares = document.getElementsByClassName("software");

    for(const soft of softwares){
        soft.addEventListener("click", async() => {
            page.UpdatePageStyle(true);
            page.active = true;
        });
    }

    document.addEventListener("click", (event) => {
        if(event.target!==page.element && page.active){
            page.active=false;
            page.UpdatePageStyle(false);
        }
    })
</script>
