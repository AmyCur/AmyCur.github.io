---
import TopBar from "../components/TopBar.astro";
const {title} = Astro.props;

---

<!doctype html>
<html lang="en">
	<head>
		<script src="https://kit.fontawesome.com/e4b9b41e06.js" crossorigin="anonymous" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title != undefined ? title : "Untitled"}</title>
	</head>
	<body>
		<!-- This works but im so stupid -->
		<TopBar title = <TopBar title={(title != undefined) ? title : "Title not set"}/>
		<div id="holder">
			<div id="content">
				<slot />
			</div>
		</div>
	</body>
</html>

<style lang="scss">
	@use "../style/consts";
	html,
	body {
		margin: 0;
		width: 100vw;
		min-height: 100vh;
		background-color: consts.$Base;
		color: consts.$Text;
		overflow-x: hidden;

		@media (pointer:none),
	    (pointer:coarse) {
			&{
				overflow: visible;
			}
		}
	}

	#holder{
        width: 100vw;
        min-height: 94vh;
        overflow: hidden;

        display: flex;
        justify-content: center;
        align-items: center;

        #content{
            width: consts.$width;
        }
    }
</style>

