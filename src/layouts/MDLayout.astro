---
import Main from "./Main.astro";
import Video from "../components/Video.astro";
import OSLink from "../components/OSLink.astro";
const {frontmatter} = Astro.props;
---

<Main title={frontmatter.title}>
    <div id="main">
        <div id="content">
            <div id="left">
                <Video />
            </div>
            <div id="right">
                <div class="top">
                    <slot />
                </div>
                <div class="bottom">
                    <div id="buttons">
                        <OSLink
                            windows={frontmatter.win}
                            mac={frontmatter.mac}
                            linux={frontmatter.linux}
                            text="Download game">
                        </OSLink>
                        <a href="/" class="button"><i class="fa-solid fa-arrow-left"></i> Go Back</a>
                    </div>
                    
                    <!-- <div id="not-working">
                        <b>Or</b><br>
                        <p><a href={frontmatter.url !== undefined ? frontmatter.url : "#"}>Manually Download</a></p>
                    </div> -->
                    
                </div>
                
            </div>
        </div>
    </div>
</Main>

<style lang="scss">
    @use "../style/consts";
    
    #main{
        display: flex;
        justify-content: center;
        margin-top: 4em;

        #content{
            width: 65%;
            display: flex;
            justify-content: space-between;

            #right{
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                margin-bottom: 1em;
                width: 45%;

                #brief{
                    margin-top: 1em;
                }
            }
        }

        #buttons{
            display: flex;
            justify-content: space-around;
        }
    }


    
