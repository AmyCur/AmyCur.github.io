---
import TopBar from "../components/TopBar.astro";
const {title} = Astro.props;

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title != undefined ? title : "Youre stupid"}</title>
	</head>
	<body>
		<!-- This works but im so stupid -->
		<TopBar title = <TopBar title={(title != undefined) ? title : "Title not set"}/>
		<slot />
	</body>
</html>

<style lang="scss">
	@use "../scss/consts";
	html,
	body {
		margin: 0;
		width: 100vw;
		min-height: 100vh;
		background-color: consts.$Base;
	}
</style>

