---
import TopBar from "../components/TopBar.astro";
const {title="", frontmatter} = Astro.props;

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<!-- This has the added feature of, if the title is not set, having the title as "true" -->
		<TopBar title={(title !== "") ? title : frontmatter.title}/>
		<slot />
	</body>
</html>

<style lang="scss">
	@use "../scss/consts";
	html,
	body {
		margin: 0;
		width: 100vw;
		min-height: 100vh;
		background-color: consts.$background-color;
	}
</style>

