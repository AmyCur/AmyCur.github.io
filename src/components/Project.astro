---
const {
    title = "Default Title",
    image = "url(/images.jpg)",
    description = "",
    url,
} = Astro.props;
---

<a href={url}>
    <div class="project" style=`background-image: ${image}`>
        <div id="text">
            <p id="title">{title}</p>
            <p id="description">{description}</p>
        </div>
    </div>
</a>
<style lang="scss">
    @use "../scss/consts";
    $width: 15em;
    $height: 40em;
    $fade-time: 0.2s;

    a {
        text-decoration: none;
    }

    .project {
        height: $height;
        width: $width;
        background-repeat: no-repeat;
        background-size: cover;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        
        #text {
            transition: color .3s ease-in;
            text-align: center;
            color: #00000000;
            font-size: 2em;
        }

        &:hover {
            width: $width * 3;
            background-color: rgba(0,0,0,0.7);
            background-blend-mode: multiply;

            #text{
                color: consts.$Text;
            }
        }
    }
</style>
