---
const {
    title = "Untitled",
    image,
    url = "#",
    description = "Undescribed",
} = Astro.props;
---

<a href={url}>
    <div class="project" style=`background-image: ${image}`>
        <div class="text">
            {title}
        </div>
    </div>
</a>

<style lang="scss">
    .project{
        width: 60vw;
    }
</style>
