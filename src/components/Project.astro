---
const {
    title = "Default Title",
    image = "url(/images.jpg)",
    description = "",
    url,
} = Astro.props;
---

<a href={url}>
    <div class="background" style=`background-image: ${image}`>
        <div class="project">
            <div id="text">
                <p id="title">{title}</p>
                <p id="description">{description}</p>
            </div>
        </div>
    </div>
</a>
<style lang="scss">
    @use "../scss/consts";
    $width: 17em;
    $height: 17em;
    $fade-time: 0.2s;

    a {
        text-decoration: none;
    }

    .background {
        background-repeat: no-repeat;
        background-size: cover;
        display: flex;
        justify-content: center;
        align-items: center;

        margin: {
            right: 2em;
        };
        
        &,
        .project {
            width: $width;
            height: $height;
            border-radius: .82em;
            background-blend-mode: multiply;

        }

        .project{
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            width: 70%;
        }

        $p: &;
        
    }
</style>
