---
const {
    title = "Untitled",
    image = "temp.jpg",
    url = "#",
    description = "Undescribed",
} = Astro.props;
---

<a href={url}>
    <div class="project">
        <div class="image" style=`background-image: url(/${image});`></div>
        <div class="text-holder">
            <div class="text">
                <span class="title">{title}</span>
                <span class="description">{description}</span>
            </div>
            
        </div>
    </div>
</a>

<style lang="scss">
    @use "../style/consts";
    $width: 17em;

    a{
        width: $width;
        height: 25em;
        display: flex;
        justify-content: center;
        text-decoration: none;
        
        &:hover{
            .project{
                .image{
                    background-color: #C5B28B;
                    background-size: 250%;

                }
                .text-holder{
                    color: consts.$Text;
                }
            }
        }
        
    }

    .project, .text-holder{
        border-radius: .5em;
        transition: all .2s ease;
        background-blend-mode: multiply;
        width: $width;
        height: 10em;
    }

    .project{
        background-position: center;
        background-size: cover;

        .image{
            transition: all .3s ease;
            width: $width;
            height: 10em;
            background-size: 300%;
            background-position: center;
            background-repeat: no-repeat;

            border: .125em solid consts.$Creme;
            border-radius: 0.3em;
        }

    }

    .text-holder{
        display: flex;
        align-items: center;
        color: consts.$Text;


        .text{

            display: flex;
            flex-direction: column;
            justify-content: space-evenly;
            align-items: baseline;

            height: 40%;

            .title{font-size: 1.5em; font-weight: 800; margin-bottom: .5em;}
        }
    }
</style>
