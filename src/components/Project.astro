---
const {
    title = "Untitled",
    image = "temp.jpg",
    url = "#",
    description = "Undescribed",
} = Astro.props;
---

<a href={url}>
    <div class="project" style=`background-image: url(/${image})`>
        <div class="text">
            {title}
        </div>
    </div>
</a>

<style lang="scss">
    a{
        width: 60em;
        display: flex;
        justify-content: center;
        color: #00000000;

        
        &:hover{
            .project{
                background-color: #FFFDD1;
                #text{
                    backdrop-filter: blur(.3em);
                }
            }
            
            
        }
        .project:hover{
            
        }
    }

    .project,#text{
        transition: all .2s ease;
        background-blend-mode: multiply;
        width: 55em;
        height: 20em;
    }
</style>
