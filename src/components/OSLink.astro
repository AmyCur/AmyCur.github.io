---
const { windows, mac, linux, text } = Astro.props;
---


<a href="#" class="link-button"
  data-windows={windows}
  data-mac={mac}
  data-linux={linux}
  data-text={text}
>
</a>



<script>
    function getOS(): string{
      const userAgent = window.navigator.userAgent;

      if (userAgent.indexOf("Win") !== -1){
        return "Win";
      }
      else if (userAgent.indexOf("Mac") !== -1){
        return "Mac";
      }
      else if (userAgent.indexOf("Linux") !== -1) {
        return "Linux";
      }

      return "Fail";
    }

    document.addEventListener("DOMContentLoaded", () => {
      const os: string = getOS(); 

      const texts: HTMLCollectionOf<HTMLLinkElement> = document.getElementsByClassName("link-button") as HTMLCollectionOf<HTMLLinkElement>;

      for(const t of texts){
        const link = t.dataset;

        const windowsHref = link.windows !== undefined ? link.windows : "#";
        const macHref = link.mac !== undefined ? link.mac : "#";
        const linuxHref = link.linux !== undefined ? link.linux : "#";
        
        const text = link.text;
        let href:any="#";
        let osIcon:string=""

        switch(os){
          case("Win"):
            href=windowsHref;
            osIcon="fa-brands fa-windows"
            break;
          case("Mac"):
            href=macHref;
            osIcon="fa-brands fa-apple"
            break;
          case("Linux"):
            href=linuxHref;
            osIcon="fa-brands fa-linux"
            break;
        }

        console.log(osIcon);
        t.href=href;
        t.innerHTML = `
          <span>
            <i class="${osIcon}"></i>
          </span>
          ${text}
        `

      
      }
    });

</script>

<style lang="scss">
    @use "../style/consts";
</style>
