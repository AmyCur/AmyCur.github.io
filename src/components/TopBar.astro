---
const {title} = Astro.props;

import "../style/TopBar.scss";
---

<div id="topbar">
    <div id="bar">
        <div id="left">
            <h1>{title}</h1>
        </div>
        <div id="right">
            <a href="/" id="Home">Home</a>
            <a href="/Projects" id="Projects">Projects</a>
            <a href="/AboutMe" id="AboutMe">About Me</a>
        </div>
    </div>
</div>

<script>

    function isMobile() {
        const regex = /Mobi|Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i;
        return regex.test(navigator.userAgent);
    }

    document.addEventListener("DOMContentLoaded", () => {
        const right = document.getElementById("right");
        if(isMobile()){
            document.getElementById("Home")!.innerHTML = '<i class="fa-solid fa-house"></i>';
            document.getElementById("Projects")!.innerHTML = '<i class="fa-solid fa-list-check"></i>';
            document.getElementById("AboutMe")!.innerHTML = '<i class="fa-solid fa-person-dress"></i>';
        }
    });
</script>
